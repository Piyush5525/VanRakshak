APP_NAME=RAKSHAK
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/vananetra.db
API_PREFIX=/api/v1
MAX_GEOMETRY_VERTICES=20000
JOB_WORKERS=2
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=240
PUBLIC_BASE_URL=http://localhost:8000

# --- identity: dev_header (development only) or jwt (required in production)
AUTH_MODE=dev_header
JWT_SECRET=
JWT_AUDIENCE=vananetra
CALLBACK_SECRET=

# --- storage
RASTER_DIR=./data/rasters
MODEL_DIR=./data/models
REPORT_OUTPUT_DIR=./data/reports
EVIDENCE_DIR=./data/evidence
MAX_EVIDENCE_MB=10

# --- satellite data: Sentinel-1/2, WorldCover, DEM come from Microsoft Planetary Computer (no key)

# --- fire
# free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_API_KEY=
# path to a licence-checked ONNX fire/smoke detector (optional)
FIRE_MODEL_PATH=
# JSON: {"name","licence","classes":["fire","smoke"],"input_size":640}
FIRE_MODEL_META=

# --- routing (tried in order): mapbox, serpapi, osrm
ROUTING_PROVIDER=mapbox,serpapi
# public token (pk.*); it is also sent to the browser for the satellite basemap
MAPBOX_API=
SERP_API=
OSRM_URL=

# --- notifications (real sends need ENVIRONMENT=production AND ALLOW_REAL_NOTIFICATIONS=true)
ALLOW_REAL_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Telegram button presses (acknowledge etc.) need polling or a webhook. Leave off if another app already uses this bot.
TELEGRAM_POLLING=false
# extra authorised chat ids, comma separated (TELEGRAM_CHAT_ID is always authorised)
TELEGRAM_AUTHORISED_CHAT_IDS=
# fire-response IVR: simulated (default, safe) | twilio | dimension (not available until its API docs/credentials are provided)
IVR_PROVIDER=simulated
IVR_RESPONSE_LABEL=Response contact
IVR_RESPONSE_NUMBER=
# a real call is refused unless the number is listed here (E.164, comma separated)
IVR_APPROVED_NUMBERS=
VOICE_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- optional: documented grid emission factor for building scenarios (kg CO2e per kWh)
GRID_EMISSION_FACTOR_KG_PER_KWH=

# Forest-change alerts by e-mail (optional; uses the SMTP_* settings above)
FOREST_ALERT_EMAIL_TO=

# Phone calls (OmniDimension voice agent). The agent must be set up in the OmniDimension dashboard to read the `message` it is given.
IVR_PROVIDER=omnidimension
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
# optional: which of your OmniDimension numbers places the call
OMNIDIM_FROM_NUMBER_ID=
# who is called, in international format, e.g. +919876543210
IVR_RESPONSE_NUMBER=
IVR_RESPONSE_LABEL=Control room
